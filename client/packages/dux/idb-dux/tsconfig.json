{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "moduleDetection": "force",
    "rootDir": "./src",
    "module": "nodenext",
    "paths": {
      "@test": ["./src/test-support/index.ts"],
      "@test/*": ["./src/test-support/*"],
      "@mszr/idb-dux": ["./src/index.ts"],
      "@mszr/idb-dux/vue": ["./src/vue/index.ts"],
      "@mszr/idb-dux/perms": ["./src/perms/index.ts"],
      "@mszr/idb-dux/admin": ["./src/admin/index.ts"],
      "@mszr/idb-dux/webhooks": ["./src/webhooks/index.ts"],
      "@mszr/idb-dux/nuxt": ["./src/nuxt/index.ts"]
    },
    "types": ["node", "vitest/globals", "@mszr/selenita/vitest"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "sourceMap": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
