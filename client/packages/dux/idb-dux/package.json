{
  "name": "@mszr/idb-dux",
  "type": "module",
  "version": "1.2.0",
  "description": "A DX/UX-first reimagining of the InstantDB developer experience",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mareszhar/idb-dux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mareszhar/idb-dux.git"
  },
  "bugs": {
    "url": "https://github.com/mareszhar/idb-dux/issues"
  },
  "keywords": [
    "instantdb",
    "database",
    "realtime",
    "permissions",
    "typescript",
    "vue",
    "nuxt",
    "intellisense",
    "dx"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/esm/vue/index.d.ts",
        "default": "./dist/esm/vue/index.js"
      },
      "require": {
        "types": "./dist/commonjs/vue/index.d.ts",
        "default": "./dist/commonjs/vue/index.js"
      }
    },
    "./perms": {
      "import": {
        "types": "./dist/esm/perms/index.d.ts",
        "default": "./dist/esm/perms/index.js"
      },
      "require": {
        "types": "./dist/commonjs/perms/index.d.ts",
        "default": "./dist/commonjs/perms/index.js"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/esm/admin/index.d.ts",
        "default": "./dist/esm/admin/index.js"
      },
      "require": {
        "types": "./dist/commonjs/admin/index.d.ts",
        "default": "./dist/commonjs/admin/index.js"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/esm/webhooks/index.d.ts",
        "default": "./dist/esm/webhooks/index.js"
      },
      "require": {
        "types": "./dist/commonjs/webhooks/index.d.ts",
        "default": "./dist/commonjs/webhooks/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/commonjs/server/index.d.ts",
        "default": "./dist/commonjs/server/index.js"
      }
    },
    "./h3": {
      "import": {
        "types": "./dist/esm/h3/index.d.ts",
        "default": "./dist/esm/h3/index.js"
      },
      "require": {
        "types": "./dist/commonjs/h3/index.d.ts",
        "default": "./dist/commonjs/h3/index.js"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/esm/hono/index.d.ts",
        "default": "./dist/esm/hono/index.js"
      },
      "require": {
        "types": "./dist/commonjs/hono/index.d.ts",
        "default": "./dist/commonjs/hono/index.js"
      }
    },
    "./elysia": {
      "import": {
        "types": "./dist/esm/elysia/index.d.ts",
        "default": "./dist/esm/elysia/index.js"
      },
      "require": {
        "types": "./dist/commonjs/elysia/index.d.ts",
        "default": "./dist/commonjs/elysia/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "tshy": {
    "selfLink": false,
    "main": true,
    "module": true,
    "project": "./tsconfig.build.json",
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.test-d.ts",
      "src/test-support/**"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./vue": "./src/vue/index.ts",
      "./perms": "./src/perms/index.ts",
      "./admin": "./src/admin/index.ts",
      "./webhooks": "./src/webhooks/index.ts",
      "./server": "./src/server/index.ts",
      "./h3": "./src/h3/index.ts",
      "./hono": "./src/hono/index.ts",
      "./elysia": "./src/elysia/index.ts"
    }
  },
  "files": [
    "!dist/**/*.test-d.*",
    "!dist/**/*.test.*",
    "!dist/**/test-support/**",
    "dist"
  ],
  "peerDependencies": {
    "@instantdb/admin": "workspace:*",
    "@instantdb/webhooks": "workspace:*",
    "elysia": "^1.0.0",
    "h3": ">=2.0.1-rc.22 <3.0.0",
    "hono": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@instantdb/admin": {
      "optional": true
    },
    "@instantdb/webhooks": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@instantdb/core": "workspace:*",
    "@instantdb/version": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@instantdb/admin": "workspace:*",
    "@instantdb/platform": "workspace:^",
    "@instantdb/resumable-stream": "workspace:*",
    "@instantdb/vue": "workspace:*",
    "@instantdb/webhooks": "workspace:*",
    "@mszr/selenita": "^0.2.2",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^25.9.3",
    "@vue/test-utils": "^2.4.10",
    "elysia": "^1.4.29",
    "h3": "2.0.1-rc.22",
    "hono": "^4.12.27",
    "jsdom": "^29.1.1",
    "tshy": "^4.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
