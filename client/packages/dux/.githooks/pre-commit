#!/bin/sh
set -eu

# dux commit guard: lint staged dux changes before Git records the commit.

repo_root="$(git rev-parse --show-toplevel)"
dux_root="$repo_root/client/packages/dux"

if [ ! -d "$dux_root" ]; then
  exit 0
fi

should_lint=0
while IFS= read -r path; do
  case "$path" in
    client/packages/dux/*)
      should_lint=1
      break
      ;;
  esac
done <<EOF
$(git diff --cached --name-only)
EOF

if [ "$should_lint" -ne 1 ]; then
  exit 0
fi

echo "[dux pre-commit] running pnpm run lint"
pnpm --dir "$dux_root" run lint
