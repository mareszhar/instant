{
  "name": "idb-dux-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Maintainer workspace for @mszr/idb-dux",
  "scripts": {
    "upi": "pnpm up -i",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "sdk:upi": "pnpm --dir idb-dux up -i",
    "sdk:dev": "pnpm --dir idb-dux exec tsc --watch --preserveWatchOutput -p tsconfig.dev.json",
    "sdk:lint": "eslint ./idb-dux/src",
    "sdk:lint:fix": "eslint ./idb-dux/src --fix",
    "sdk:check-baseline-drift": "node scripts/check-baseline-drift.mjs",
    "sdk:typecheck": "pnpm --dir idb-dux exec tsc --noEmit",
    "sdk:test": "pnpm --dir idb-dux exec vitest run --typecheck",
    "sdk:test:watch": "pnpm --dir idb-dux exec vitest --typecheck",

    "sdk:build:version": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/version build",
    "sdk:build:core": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/core build",
    "sdk:build:vue": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/vue build",
    "sdk:build:webhooks": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/webhooks build",
    "sdk:build:platform": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/platform build",
    "sdk:build:admin": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/admin build",
    "sdk:build:resumable-stream": "npm_config_cache=.npm-cache npm_config_loglevel=error pnpm --dir ../.. --filter @instantdb/resumable-stream build",
    "sdk:build:tshy": "pnpm --dir idb-dux exec tshy",
    "sdk:check-exports": "npm_config_cache=.npm-cache pnpm --dir idb-dux exec attw --profile node16 --pack .",
    "sdk:build:ours": "rm -rf idb-dux/dist && pnpm run sdk:build:tshy && pnpm run sdk:check-exports",
    "sdk:build:all": "pnpm run sdk:build:version && pnpm run sdk:build:core && pnpm run sdk:build:vue && pnpm run sdk:build:webhooks && pnpm run sdk:build:platform && pnpm run sdk:build:admin && pnpm run sdk:build:resumable-stream && pnpm run sdk:build:ours",

    "sdk:pack:version": "pnpm run sdk:build:version && pnpm --dir ../version pack --pack-destination ../dux/packs",
    "sdk:pack:core": "pnpm run sdk:build:core && pnpm --dir ../core pack --pack-destination ../dux/packs",
    "sdk:pack:webhooks": "pnpm run sdk:build:webhooks && pnpm --dir ../webhooks pack --pack-destination ../dux/packs",
    "sdk:pack:admin": "pnpm run sdk:build:admin && pnpm --dir ../admin pack --pack-destination ../dux/packs",
    "sdk:pack:ours": "pnpm run sdk:build:ours && pnpm --dir idb-dux pack --pack-destination ../packs",
    "spo": "pnpm run sdk:pack:ours",
    "sdk:pack:all": "mkdir -p packs .npm-cache && rm -f packs/*.tgz && pnpm run sdk:pack:version && pnpm run sdk:pack:core && pnpm run sdk:pack:webhooks && pnpm run sdk:pack:admin && pnpm run sdk:pack:ours",
    "spa": "pnpm run sdk:pack:all",

    "sdk:demo:main:idb": "node scripts/manage-demo-idb-resolution.mjs status --demo main",
    "sdmi": "pnpm run sdk:demo:main:idb",
    "sdk:demo:sandbox:idb": "node scripts/manage-demo-idb-resolution.mjs status --demo sandbox",
    "sdsi": "pnpm run sdk:demo:sandbox:idb",
    "sdk:demo:main:idb:links": "node scripts/manage-demo-idb-resolution.mjs set --demo main --idb links",
    "sdmil": "pnpm run sdk:demo:main:idb:links",
    "sdk:demo:main:idb:tarballs": "node scripts/manage-demo-idb-resolution.mjs set --demo main --idb tarballs",
    "sdmit": "pnpm run sdk:demo:main:idb:tarballs",
    "sdk:demo:main:idb:npm": "node scripts/manage-demo-idb-resolution.mjs set --demo main --idb npm",
    "sdmin": "pnpm run sdk:demo:main:idb:npm",
    "sdk:demo:pick:idb": "node scripts/manage-demo-idb-resolution.mjs pick",
    "sdpi": "pnpm run sdk:demo:pick:idb",
    "sdk:demo:main:refresh": "node scripts/refresh-our-demos.mjs main",
    "sdmr": "pnpm run sdk:demo:main:refresh",
    "sdk:demo:pick:refresh": "node scripts/refresh-our-demos.mjs pick",
    "sdpr": "pnpm run sdk:demo:pick:refresh",
    "sdk:demo:all:refresh": "node scripts/refresh-our-demos.mjs all",
    "sdar": "pnpm run sdk:demo:all:refresh",
    "sdk:demo:all:upi": "node scripts/command-demo-all.mjs --command upi",
    "sdau": "pnpm run sdk:demo:all:upi",
    "sdk:demo:all:typecheck": "node scripts/command-demo-all.mjs --command typecheck",
    "sdat": "pnpm run sdk:demo:all:typecheck",
    "sdk:demo:all:build": "node scripts/command-demo-all.mjs --command build",
    "sdab": "pnpm run sdk:demo:all:build",
    "sdk:demo:main:prep": "pnpm --dir idb-dux/demo run prep",
    "sdmp": "pnpm run sdk:demo:main:prep",
    "sdk:demo:main:dev": "pnpm --dir idb-dux/demo run dev",
    "sdmd": "pnpm run sdk:demo:main:dev",
    "sdk:demo:main:build": "pnpm --dir idb-dux/demo run build",
    "sdmb": "pnpm run sdk:demo:main:build",
    "sdk:demo:main:lint": "eslint ./idb-dux/demo",
    "sdml": "pnpm run sdk:demo:main:lint",
    "sdk:demo:main:lint:fix": "eslint ./idb-dux/demo --fix",
    "sdmlf": "pnpm run sdk:demo:main:lint:fix",
    "sdk:demo:main:validate": "pnpm run sdk:demo:main:lint && pnpm --dir idb-dux/demo run typecheck",
    "sdmv": "pnpm run sdk:demo:main:validate",
    "sdk:demo:main:validate:fix": "pnpm run sdk:demo:main:lint:fix && pnpm --dir idb-dux/demo run typecheck",
    "sdmvf": "pnpm run sdk:demo:main:validate:fix",
    "pack:all:refresh:all": "pnpm run sdk:pack:all && pnpm run sdk:demo:all:refresh",
    "para": "pnpm run pack:all:refresh:all",

    "prepublish:verify": "node scripts/prepublish-verify.mjs",
    "publish:sdk:dry-run": "node scripts/publish-sdk.mjs --dry-run",
    "publish:sdk:patch": "node scripts/publish-sdk.mjs patch",
    "publish:sdk:minor": "node scripts/publish-sdk.mjs minor",
    "publish:sdk:major": "node scripts/publish-sdk.mjs major",
    "publish:demo:prev": "node scripts/publish-demo.mjs --prev",
    "publish:demo:prod": "node scripts/publish-demo.mjs --prod",
    "publish:subtree:squash": "node scripts/publish-subtree.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1"
  }
}
