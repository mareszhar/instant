{
  "name": "@mszr/idb-vux",
  "type": "module",
  "version": "0.1.0",
  "description": "Vue client for InstantDB",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mareszhar/idb-vux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mareszhar/idb-vux.git"
  },
  "bugs": {
    "url": "https://github.com/mareszhar/idb-vux/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/esm/nuxt.d.ts",
        "default": "./dist/esm/nuxt.js"
      },
      "require": {
        "types": "./dist/commonjs/nuxt.d.ts",
        "default": "./dist/commonjs/nuxt.js"
      }
    },
    "./dist/cli": {
      "import": {
        "types": "./dist/esm/cli.d.ts",
        "default": "./dist/esm/cli.js"
      },
      "require": {
        "types": "./dist/commonjs/cli.d.ts",
        "default": "./dist/commonjs/cli.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "tshy": {
    "selfLink": false,
    "main": true,
    "module": true,
    "project": "./tsconfig.json",
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./nuxt": "./src/nuxt.ts",
      "./dist/cli": "./src/cli.ts"
    }
  },
  "files": [
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "dist"
  ],
  "scripts": {
    "upi": "pnpm up -i",
    "dev": "tsc --watch --preserveWatchOutput -p tsconfig.dev.json",
    "typecheck": "tsc --noEmit",
    "check-exports": "npm_config_cache=.npm-cache attw --profile node16 --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "build:tshy": "tshy",
    "build:cli-compat": "cp dist/commonjs/cli.d.ts dist/cli.d.ts && printf \"module.exports = require('./commonjs/cli.js')\\n\" > dist/cli.js",
    "build": "rm -rf dist && pnpm run build:tshy && pnpm run build:cli-compat && pnpm run check-exports"
  },
  "peerDependencies": {
    "@instantdb/admin": "workspace:*",
    "h3": "^1.15.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@instantdb/admin": {
      "optional": true
    },
    "h3": {
      "optional": true
    }
  },
  "dependencies": {
    "@instantdb/core": "workspace:*",
    "@instantdb/version": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@instantdb/admin": "workspace:*",
    "@vue/test-utils": "^2.4.10",
    "h3": "^1.15.3",
    "jsdom": "^29.1.1",
    "tshy": "^4.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
