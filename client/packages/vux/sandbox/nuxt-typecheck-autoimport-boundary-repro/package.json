{
  "name": "nuxt-typecheck-autoimport-boundary-repro",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "prep": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "typecheck:split": "nuxt prepare && bun run typecheck:app && bun run typecheck:server",
    "typecheck:app": "vue-tsc --project .nuxt/tsconfig.app.json --noEmit",
    "typecheck:server": "tsc --project .nuxt/tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "nuxt": "4.4.6",
    "vue": "3.5.34",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vue-tsc": "3.3.1"
  }
}
